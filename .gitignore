# ============================================
# Dependencies (восстанавливаются `npm install`)
# ============================================
node_modules/
jspm_packages/

# Optional npm/yarn artefacts
.npm/
.yarn-integrity
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/

# ============================================
# Build output (генерируется `npm run build`)
# ============================================
dist/
build/
out/

# Кэши сборщиков (Vite / Webpack / Parcel / Turbo / SWC)
.vite/
.cache/
.parcel-cache/
.turbo/
.swc/
.eslintcache
.stylelintcache
tsconfig.tsbuildinfo

# ============================================
# Environment (никогда не коммитим реальные секреты;
# .env.example остаётся в репо как шаблон)
# ============================================
.env
.env.local
.env.*.local

# ============================================
# Базы данных
# dev.db (SQLite) КОММИТИТСЯ — чтобы новый разработчик
# сразу получил демонстрационные данные. Игнорируем только
# временные WAL-файлы и сторонние форматы.
# ============================================
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ============================================
# Тесты и покрытие
# ============================================
coverage/
*.lcov
.nyc_output/
junit.xml

# Playwright / e2e
.playwright-mcp/
playwright-report/
test-results/
playwright/.cache/

# ============================================
# Логи
# ============================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# OS
# ============================================
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ============================================
# Editors / IDE
# ============================================
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# ============================================
# Dev-tool configs (Claude Code / MCP)
# ============================================
.claude/
.mcp.json

# ============================================
# Python (для скриптов генерации диплома)
# ============================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
env/
.pytest_cache/
*.egg-info/

# ============================================
# Временные / архивы
# ============================================
tmp/
temp/
*.tgz
*.tar.gz
*.zip

# MS Office lock-файлы
~$*.docx
~$*.xlsx
~$*.pptx

# ============================================
# Личные материалы диплома (не часть приложения)
