# Используется docker-compose.yml.
# Скопируйте этот файл в `.env`:  cp .env.example .env

# Gmail SMTP (опционально — без этих переменных всё работает,
# кроме отправки писем для восстановления пароля и подтверждения заказа)
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# JWT-секрет для подписи токенов
JWT_SECRET=change_me_to_a_random_secret

# Пароль входа в админ-панель
ADMIN_PASSWORD=look-admin-2024
