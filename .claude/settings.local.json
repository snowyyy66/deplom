{
  "permissions": {
    "allow": [
      "Bash(grep -E \"\\(package\\\\.json|\\\\.js$\\)\")",
      "Bash(xargs grep *)",
      "Bash(npm install *)",
      "PowerShell(wsl --status 2>&1)",
      "PowerShell(wsl --update 2>&1)",
      "PowerShell(tail -50)",
      "PowerShell(docker exec look_api wget -qO- http://localhost:8000/api/menu 2>&1)",
      "PowerShell(docker exec look_api ls /app/src 2>&1)",
      "PowerShell(docker exec look_api cat /app/src/main.ts 2>&1)",
      "PowerShell(docker exec look_api cat /app/src/main.js 2>&1)",
      "PowerShell(docker exec look_api sh -c \"ps aux && netstat -tlnp 2>/dev/null || ss -tlnp\" 2>&1)",
      "PowerShell(docker exec look_api sh -c \"ss -tlnp 2>/dev/null || netstat -tlnp 2>/dev/null\" 2>&1)",
      "PowerShell(docker exec look_api wget -qO- http://127.0.0.1:8000/api/menu 2>&1)",
      "Bash(sqlite3 backend/prisma/dev.db \".tables\")",
      "PowerShell(docker cp backend/prisma/dev.db look_postgres:/tmp/dev.db 2>&1)",
      "PowerShell(docker exec look_postgres sh -c \"apk add --no-cache sqlite 2>/dev/null && sqlite3 /tmp/dev.db '.tables'\" 2>&1)"
    ]
  }
}
