generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int      @id @default(autoincrement())
  name                String
  email               String   @unique
  phone               String
  passwordHash        String   @map("password_hash")
  hasFoundEasterEgg   Boolean  @default(false) @map("has_found_easter_egg")
  runnerPromoEligible Boolean  @default(false) @map("runner_promo_eligible")
  role                String   @default("user")
  createdAt           DateTime @default(now()) @map("created_at")

  reservations        Reservation[]
  orders              Order[]
  reviews             Review[]

  @@index([role])
  @@map("users")
}

model MenuItem {
  id          Int     @id @default(autoincrement())
  name        String
  price       Int
  category    String
  imageUrl    String  @map("image_url")
  rating      Float
  prepTime    Int     @map("prep_time")
  description String?
  tag         String?
  isAvailable Boolean @default(true) @map("is_available")

  orderItems  OrderItem[]

  @@index([category])
  @@index([isAvailable])
  @@map("menu_items")
}

model Reservation {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")
  name         String
  phone        String
  date         DateTime
  time         String
  guestsCount  Int      @map("guests_count")
  tableNumber  Int?     @map("table_number")
  notes        String?
  status       String   @default("pending")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([date, time])
  @@index([userId])
  @@index([status])
  @@map("reservations")
}

model Order {
  id            Int        @id @default(autoincrement())
  userId        Int?       @map("user_id")
  address       String
  phone         String
  recipientName String     @map("recipient_name")
  comment       String?
  totalAmount   Int        @map("total_amount")
  promoCode     String?    @map("promo_code")
  email         String?
  status        String     @default("new")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")

  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]

  @@index([email])
  @@index([userId])
  @@index([promoCode])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  menuItemId   Int      @map("menu_item_id")
  quantity     Int
  price        Int
  nameSnapshot String?  @map("name_snapshot")

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  authorName String   @map("author_name")
  rating     Int
  text       String
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("reviews")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_messages")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String?
  tokenHash String?  @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)

  @@index([email])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model PromoCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  discount    Int
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  validFrom   DateTime? @map("valid_from")
  validUntil  DateTime? @map("valid_until")
  usageLimit  Int?      @map("usage_limit")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([code])
  @@index([isActive])
  @@map("promo_codes")
}
