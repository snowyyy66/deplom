# === Локальная разработка (SQLite) ===
DATABASE_URL=file:./dev.db

# === Docker / Production (PostgreSQL) ===
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/look?schema=public

# JWT-секрет (любая случайная строка, в проде — генерировать!)
JWT_SECRET=change_me_to_a_random_secret

# Пароль входа в /admin
# Можно указать либо открытый пароль (ADMIN_PASSWORD),
# либо bcrypt-хэш (ADMIN_PASSWORD_HASH) — рекомендуется в проде.
# Сгенерировать хэш: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD=admin123
# ADMIN_PASSWORD_HASH=$2a$10$....

# Порт API
PORT=8000

# Разрешённые CORS-origins (через запятую)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gmail SMTP (опционально, для отправки писем восстановления пароля и подтверждения заказов)
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
