# Локальная разработка (без PostgreSQL):
DATABASE_URL=file:./dev.db

# Продакшн / Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/look?schema=public

GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=your_app_password

